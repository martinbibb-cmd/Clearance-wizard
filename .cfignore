# Cloudflare Pages ignore file
# These files/directories should not be processed during deployment

# Monorepo directories (React Native app and packages)
apps/
packages/

# Python development code (not needed for web app deployment)
python-dev/
*.py
__pycache__/
*.pyc
.pytest_cache/

# Node.js dependencies (will be installed during build if needed)
node_modules/

# Git and development files
.git/
.github/
.gitignore

# Documentation
*.md

# Test files
test_ar_alignment.html
test-*.html
